{
  "manifest_version": 2,
  "name": "BugMeNot Autofill",
  "version": "0.1.0",
  "description": "Autofill login forms using BugMeNot credentials.",
  "browser_specific_settings": {
    "gecko": {
      "id": "bugmenot-autofill@example.com",
      "strict_min_version": "57.0"
    }
  },
  "permissions": [
    "menus",
    "*://*/*"
  ],
  "background": {
    "scripts": ["dist/background/background.js"]
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["dist/content/content.js"],
      "run_at": "document_idle"
    }
  ]
}
